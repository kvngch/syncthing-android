<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- The screens are drawn by Compose: the theme only colors the window and the system bars. -->
    <style name="Theme.Syncthing" parent="Base.Theme.Syncthing">
        <item name="android:colorPrimary">@color/primary</item>
        <item name="android:colorPrimaryDark">@color/primary_dark</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:fitsSystemWindows">true</item>
    </style>

    <style name="Base.Theme.Syncthing" parent="android:Theme.Material.Light.NoActionBar" />

</resources>
